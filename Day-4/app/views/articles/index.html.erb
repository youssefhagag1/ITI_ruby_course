<h1>Articles</h1>
<%= link_to "Write New Article", new_article_path, class: "btn btn-primary" if logged_in? %>
<hr>

<% @articles.each do |article| %>
  <div style="border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:6px;">
    <h2><%= link_to article.title, article_path(article) %></h2>
    <small>By <strong><%= article.user.username %></strong> &middot; <%= article.created_at.strftime("%B %d, %Y") %></small>
    <p><%= truncate(article.body, length: 150) %></p>
    <small style="color:#999;">Reports: <%= article.reports_count %></small>
  </div>
<% end %>

<% if @articles.empty? %>
  <p>No articles yet. Be the first to write one!</p>
<% end %>
